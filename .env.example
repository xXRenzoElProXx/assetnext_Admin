# Nunca subas .env ni la URL de Supabase al repositorio.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres?sslmode=require
ADMIN_EMAIL=admin@assetnext.tech
# Genera con: py -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=
# Usa la contraseña de aplicación del correo, nunca la contraseña normal de Gmail.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=assetnext.tech@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=assetnext.tech@gmail.com
MAIL_USE_TLS=true
# En producción usa HTTPS y la IP pública/VPN de los administradores. Separar varias con comas.
ADMIN_ALLOWED_IPS=
ADMIN_ENV=development
ADMIN_PORT=5101
# En producción, añade el host del panel y sus orígenes HTTPS si frontend/API están separados.
ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_CSRF_TRUSTED_ORIGINS=
# Actívalo solo si un proxy confiable elimina y fija X-Forwarded-Proto.
ADMIN_TRUST_PROXY=false
